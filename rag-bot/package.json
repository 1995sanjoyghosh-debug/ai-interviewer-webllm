{
  "name": "rag-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@huggingface/inference": "^1.8.0",
    "axios": "^1.7.6",
    "cheerio": "^1.0.0-rc.14",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.4",
    "langchain": "^0.0.160",
    "mammoth": "^1.4.24",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
